<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_sns_credit_followup" model="mail.template">
            <field name="name">Credit Follow-up: Overdue Invoice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">[ทวงถาม/Reminder] Invoice {{ object.name }} - ครบกำหนดชำระ</field>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;">
    <p>เรียน คุณ<t t-out="object.partner_id.name or ''"/>,</p>
    <p>
        ใบกำกับภาษี / Invoice <strong t-out="object.name or ''"/> ครบกำหนดชำระแล้ว
        กรุณาตรวจสอบและชำระค่าสินค้าโดยเร็วที่สุด
    </p>
    <ul>
        <li>เลขที่: <t t-out="object.name or ''"/></li>
        <li>วันที่ครบกำหนด: <t t-out="object.invoice_date_due and object.invoice_date_due.strftime('%d/%m/%Y') or ''"/></li>
        <li>ยอดค้างชำระ: <t t-out="'{:,.2f}'.format(object.amount_residual or 0)"/> <t t-out="object.currency_id.name or ''"/></li>
    </ul>
    <p>หากชำระแล้วกรุณาแนบหลักฐานการโอนเงินผ่านระบบ หรือส่งกลับอีเมลนี้ ขอบคุณครับ</p>
    <p>บริษัท เอส แอนด์ เอส มัลติโปรดักส์ จำกัด</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
