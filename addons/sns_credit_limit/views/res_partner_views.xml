<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_sns_credit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sns.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='credit_limit']" position="after">
                <field name="sns_outstanding_ar"/>
                <field name="sns_pending_so_amount"/>
                <field name="sns_credit_used"/>
                <field name="sns_credit_available"/>
                <field name="sns_credit_used_pct" widget="percentage"/>
            </xpath>
        </field>
    </record>

</odoo>
