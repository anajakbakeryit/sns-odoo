<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sns_sale_duplicate_check_res_config_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sns.sale.duplicate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Duplicate SO Detection" id="sns_duplicate_check_block">
                    <setting id="sns_duplicate_check_enabled_setting"
                             string="Detect duplicate Sales Orders"
                             help="Warn when a user confirms a Sales Order that looks similar to another recent order for the same customer.">
                        <field name="sns_duplicate_check_enabled"/>
                        <div class="content-group" invisible="not sns_duplicate_check_enabled">
                            <div class="mt16">
                                <label for="sns_duplicate_check_days" string="Check window (days)"/>
                                <field name="sns_duplicate_check_days" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
